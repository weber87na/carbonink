{
	"name": "carbonink-monorepo",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=20",
		"npm": ">=11 <12"
	},
	"packageManager": "npm@11.8.0",
	"workspaces": [
		"desktop",
		"cloud/web"
	],
	"scripts": {
		"desktop:dev": "npm run dev --workspace=carbonink",
		"desktop:build": "npm run build --workspace=carbonink",
		"desktop:test": "npm run test --workspace=carbonink",
		"desktop:typecheck": "npm run typecheck --workspace=carbonink",
		"desktop:lint": "npm run lint --workspace=carbonink",
		"cloud:lint": "biome check cloud",
		"cloud:build:web": "npm run build --workspace=@carbonink-cloud/web",
		"test": "npm run test --workspaces --if-present",
		"lint": "npm run lint --workspaces --if-present",
		"typecheck": "npm run typecheck --workspaces --if-present"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"happy-dom": "20.9.0"
	}
}
