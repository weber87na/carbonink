---
export const prerender = true;

import Base from '../../layouts/Base.astro';
import DownloadButtons from '../../components/DownloadButtons.astro';
import LogoMark from '../../components/LogoMark.astro';
// Read the version from desktop/package.json at build time so it stays in
// sync with each release. Download buttons independently resolve the latest
// GitHub release assets at request time (lib/latest-download.ts).
import desktopPkg from '../../../../../desktop/package.json';

const version = `v${desktopPkg.version}`;
---
<Base
  title="下載碳墨 — macOS / Windows 免費碳核算軟體"
  description="免費下載碳墨桌面端（macOS / Windows）。開放原始碼碳核算 / 碳盤查軟體，完全離線執行，無需註冊帳號。"
  lang="zh-TW"
>
  <section class="py-28 px-5">
    <div class="max-w-lg mx-auto text-center">
      <div class="inline-flex justify-center">
        <LogoMark size={44} />
      </div>
      <h1 class="text-3xl font-semibold tracking-tight mt-6 mb-2">下載碳墨</h1>
      <p class="text-muted-foreground text-sm mb-10" style="font-family: var(--font-mono);">
        目前版本 {version}（Windows 自動更新，macOS 新版提示）
      </p>

      <DownloadButtons lang="zh-TW" />
    </div>
  </section>
</Base>
